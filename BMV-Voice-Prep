<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GDEgo | Professional Driver Prep</title>
    <style>
        :root { --gde-blue: #002d62; --gde-gold: #ffcc00; }
        body { font-family: 'Segoe UI', sans-serif; background: #f0f2f5; margin: 0; padding-bottom: 50px; }
        header { background: var(--gde-blue); color: white; padding: 50px 20px; text-align: center; border-bottom: 6px solid var(--gde-gold); }
        h1 { margin: 0; font-size: 3em; }
        .search-area { position: sticky; top: 0; background: white; padding: 20px; z-index: 1000; box-shadow: 0 4px 15px rgba(0,0,0,0.1); text-align: center; }
        #mainSearch { width: 80%; padding: 15px; border-radius: 30px; border: 2px solid #ccc; font-size: 1.1em; outline: none; }
        .mic-btn { font-size: 1.5em; cursor: pointer; background: none; border: none; vertical-align: middle; }
        .container { max-width: 850px; margin: 30px auto; padding: 0 15px; }
        .qa-card { background: white; border-radius: 12px; padding: 25px; margin-bottom: 20px; border-left: 10px solid var(--gde-blue); box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .q-text { font-weight: 800; font-size: 1.2em; color: #111; }
        .a-text { margin-top: 15px; background: #e7f3ff; color: #004085; padding: 15px; border-radius: 6px; font-weight: 600; border: 1px solid #cce5ff; }
        .hidden { display: none !important; }
    </style>
</head>
<body>
<header><h1>GDEgo</h1><p>The Universal Road to Your License</p></header>
<div class="search-area">
    <input type="text" id="mainSearch" placeholder="Search or tap mic..." onkeyup="runFilter()">
    <button class="mic-btn" onclick="toggleVoice()">🎤</button>
</div>
<div class="container" id="qaList">
    <div class="qa-card" data-state="ohio">
        <div class="q-text">OHIO: When following a vehicle at night, you must use...?</div>
        <div class="a-text">Low-beam headlights.</div>
    </div>
    <div class="qa-card" data-exam="pretrip">
        <div class="q-text">CDL PRE-TRIP: How much play is allowed in a steering wheel?</div>
        <div class="a-text">No more than 10 degrees (about 2 inches on a 20-inch wheel).</div>
    </div>
</div>
<script>
    function runFilter() {
        let input = document.getElementById('mainSearch').value.toLowerCase();
        let cards = document.getElementsByClassName('qa-card');
        for (let i = 0; i < cards.length; i++) {
            cards[i].classList.toggle('hidden', !cards[i].innerText.toLowerCase().includes(input));
        }
    }
    function toggleVoice() {
        const recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
        recognition.onresult = (e) => {
            document.getElementById('mainSearch').value = e.results[0][0].transcript;
            runFilter();
        };
        recognition.start();
    }
</script>
</body>
</html>
