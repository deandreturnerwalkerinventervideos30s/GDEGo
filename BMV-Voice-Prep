<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BMV & CDL Master | Voice Search</title>
    <style>
        :root { --pro-blue: #001f3f; --cdl-orange: #ff851b; --light-bg: #f8f9fa; }
        body { font-family: 'Segoe UI', sans-serif; background: var(--light-bg); margin: 0; padding-bottom: 50px; }
        
        header { background: var(--pro-blue); color: white; padding: 40px 20px; text-align: center; border-bottom: 6px solid var(--cdl-orange); }
        
        /* Voice Search Bar Styling */
        .search-wrapper { position: sticky; top: 0; background: white; padding: 15px; z-index: 1000; box-shadow: 0 4px 10px rgba(0,0,0,0.1); display: flex; flex-direction: column; align-items: center; gap: 10px; }
        .input-holder { position: relative; width: 90%; max-width: 500px; }
        #keywordSearch { width: 100%; padding: 15px 50px 15px 20px; border-radius: 30px; border: 2px solid #ddd; font-size: 1.1em; box-sizing: border-box; }
        
        /* The Microphone Button */
        .mic-btn { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); background: none; border: none; font-size: 1.5em; cursor: pointer; color: var(--pro-blue); }
        .mic-active { color: red; animation: pulse 1.5s infinite; }

        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }

        .container { max-width: 900px; margin: 20px auto; padding: 0 15px; }
        .qa-card { background: white; border-radius: 10px; padding: 20px; margin-bottom: 15px; border-left: 8px solid var(--pro-blue); box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .question { font-weight: bold; font-size: 1.2em; margin-bottom: 15px; }
        .answer-text { background: #fffde7; padding: 15px; border-radius: 5px; font-weight: bold; color: #856404; border: 1px solid #ffe58f; }
        
        .hidden { display: none !important; }
    </style>
</head>
<body>

<header>
    <h1>BMV & CDL Voice Master</h1>
    <p>Tap the Mic to Ask a Question</p>
</header>

<div class="search-wrapper">
    <div class="input-holder">
        <input type="text" id="keywordSearch" placeholder="Search or tap mic to speak..." onkeyup="applyFilters()">
        <button class="mic-btn" id="startMic" onclick="startVoice()">🎤</button>
    </div>
</div>

<div class="container" id="qaLibrary">
    <div class="qa-card">
        <div class="question">What is the legal blood alcohol limit for drivers under 21 in Ohio?</div>
        <div class="answer-text">0.02%</div>
    </div>

    <div class="qa-card">
        <div class="question">How many feet should you signal before a turn?</div>
        <div class="answer-text">At least 100 feet.</div>
    </div>
    
    <div class="qa-card">
        <div class="question">What are the four steps of a pre-trip air brake test?</div>
        <div class="answer-text">1. Applied Pressure Test, 2. Warning Light/Buzzer, 3. Protection Valve Pop-out, 4. Static Leak Test.</div>
    </div>
</div>

<script>
    // 1. REGULAR TEXT SEARCH
    function applyFilters() {
        const search = document.getElementById('keywordSearch').value.toLowerCase();
        const cards = document.getElementsByClassName('qa-card');

        for (let i = 0; i < cards.length; i++) {
            const cardText = cards[i].innerText.toLowerCase();
            cards[i].classList.toggle('hidden', !cardText.includes(search));
        }
    }

    // 2. VOICE SEARCH LOGIC
    function startVoice() {
        const micBtn = document.getElementById('startMic');
        const searchBar = document.getElementById('keywordSearch');
        
        // Check if browser supports speech
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognition) {
            alert("Voice search is not supported in this browser. Try Chrome!");
            return;
        }

        const recognition = new SpeechRecognition();
        recognition.lang = 'en-US';

        recognition.onstart = () => {
            micBtn.classList.add('mic-active');
            searchBar.placeholder = "Listening...";
        };

        recognition.onresult = (event) => {
            const transcript = event.results[0][0].transcript;
            searchBar.value = transcript;
            micBtn.classList.remove('mic-active');
            searchBar.placeholder = "Search or tap mic to speak...";
            applyFilters(); // Automatically filter the list based on what was said
        };

        recognition.onerror = () => {
            micBtn.classList.remove('mic-active');
            alert("Microphone error. Please check permissions.");
        };

        recognition.start();
    }
</script>

</body>
</html>
