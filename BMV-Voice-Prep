<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GDEgo | Professional Driver Prep</title>
    <style>
        :root { --gde-blue: #002d62; --gde-gold: #ffcc00; --white: #ffffff; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f0f2f5; margin: 0; padding-bottom: 50px; }
        
        /* Branding Header */
        header { background: var(--gde-blue); color: white; padding: 50px 20px; text-align: center; border-bottom: 6px solid var(--gde-gold); }
        h1 { margin: 0; font-size: 3em; letter-spacing: 2px; }
        .tagline { margin-top: 10px; font-weight: 300; letter-spacing: 1px; }

        /* Voice Search & Filter Bar */
        .search-area { position: sticky; top: 0; background: white; padding: 20px; z-index: 1000; box-shadow: 0 4px 15px rgba(0,0,0,0.1); display: flex; flex-direction: column; align-items: center; gap: 15px; }
        .mic-container { position: relative; width: 90%; max-width: 500px; }
        #mainSearch { width: 100%; padding: 15px 50px 15px 20px; border-radius: 30px; border: 2px solid #ccc; font-size: 1.1em; outline: none; box-sizing: border-box; }
        .mic-btn { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); background: none; border: none; font-size: 1.5em; cursor: pointer; color: var(--gde-blue); }
        .mic-active { color: #ff0000; animation: pulse 1s infinite; }

        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }

        .filters { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
        select { padding: 10px; border-radius: 5px; border: 1px solid #ddd; background: #fff; }

        /* Q&A List */
        .container { max-width: 850px; margin: 30px auto; padding: 0 15px; }
        .qa-card { background: white; border-radius: 12px; padding: 25px; margin-bottom: 20px; border-left: 10px solid var(--gde-blue); box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .category-tag { background: #eee; padding: 4px 10px; border-radius: 4px; font-size: 0.7em; font-weight: bold; text-transform: uppercase; margin-bottom: 15px; display: inline-block; }
        .q-text { font-weight: 800; font-size: 1.2em; color: #111; margin-bottom: 15px; }
        .a-label { color: var(--gde-blue); font-weight: bold; font-size: 0.8em; text-transform: uppercase; margin-bottom: 5px; }
        .a-text { background: #e7f3ff; color: #004085; padding: 15px; border-radius: 6px; font-weight: 600; border: 1px solid #cce5ff; }

        .hidden { display: none !important; }
    </style>
</head>
<body>

<header>
    <h1>GDEgo</h1>
    <div class="tagline">The Universal Road to Your License</div>
</header>

<div class="search-area">
    <div class="mic-container">
        <input type="text" id="mainSearch" placeholder="Search or tap mic to speak..." onkeyup="runFilter()">
        <button class="mic-btn" id="micBtn" onclick="toggleVoice()">🎤</button>
    </div>
    <div class="filters">
        <select id="stateSelect" onchange="runFilter()">
            <option value="all">All States</option>
            <option value="ohio">Ohio</option>
            <option value="pennsylvania">Pennsylvania</option>
            <option value="california">California</option>
        </select>
        <select id="examSelect" onchange="runFilter()">
            <option value="all">All Exams</option>
            <option value="regular">Regular Driver</option>
            <option value="cdl-a">CDL Class A</option>
            <option value="pretrip">Pre-Trip Inspection</option>
        </select>
    </div>
</div>

<div class="container" id="qaList">
    <div class="qa-card" data-state="ohio" data-exam="regular">
        <span class="category-tag">Ohio | Regular</span>
        <div class="q-text">What is the "Four-Second Rule"?</div>
        <div class="a-label">Official Answer:</div>
        <div class="a-text">A way to measure safe following distance behind another vehicle.</div>
    </div>

    <div class="qa-card" data-state="all" data-exam="pretrip">
        <span class="category-tag">Universal | Pre-Trip</span>
        <div class="q-text">How do you inspect the Slack Adjusters and Pushrods?</div>
        <div class="a-label">Official Answer:</div>
        <div class="a-text">Check for broken, loose, or missing parts. With brakes released, the pushrod should not move more than 1 inch when pulled by hand.</div>
    </div>
</div>

<script>
    function runFilter() {
        const search = document.getElementById('mainSearch').value.toLowerCase();
        const state = document.getElementById('stateSelect').value.toLowerCase();
        const exam = document.getElementById('examSelect').value.toLowerCase();
        const cards = document.getElementsByClassName('qa-card');

        for (let i = 0; i < cards.length; i++) {
            const cardState = cards[i].getAttribute('data-state').toLowerCase();
            const cardExam = cards[i].getAttribute('data-exam').toLowerCase();
            const cardText = cards[i].innerText.toLowerCase();

            const stateMatch = (state === 'all' || cardState === state || cardState === 'all');
            const examMatch = (exam === 'all' || cardExam === exam);
            const searchMatch = cardText.includes(search);

            if (stateMatch && examMatch && searchMatch) {
                cards[i].classList.remove('hidden');
            } else {
                cards[i].classList.add('hidden');
            }
        }
    }

    function toggleVoice() {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognition) return alert("Browser not supported.");
        
        const rec = new SpeechRecognition();
        const btn = document.getElementById('micBtn');
        const bar = document.getElementById('mainSearch');

        rec.onstart = () => btn.classList.add('mic-active');
        rec.onresult = (e) => {
            bar.value = e.results[0][0].transcript;
            btn.classList.remove('mic-active');
            runFilter();
        };
        rec.onerror = () => btn.classList.remove('mic-active');
        rec.start();
    }
</script>

</body>
</html>
